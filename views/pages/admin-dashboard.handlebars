    <!-- NAV -->
    <nav class="navbar">
      <a class="nav-logo" href="/">Stable<span>Stay</span></a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/buildings">Browse Rentals</a></li>
        <li><a href="/admin" class="active">Admin</a></li>
      </ul>
      <div class="nav-actions">
        {{#if user}}
          <span style="font-size:0.88rem;color:var(--text-muted);font-weight:500;padding:0 4px;">Hi, {{user.firstName}}</span>
          <a href="/signout" class="btn btn-primary">Sign Out</a>
        {{/if}}
      </div>
    </nav>

    <!-- ADMIN LAYOUT -->
    <div class="admin-layout">

      <!-- SIDEBAR -->
      <aside class="admin-sidebar">
        <div class="admin-sidebar-title">Dashboard</div>
        <ul class="admin-nav">
          <li><a href="#" class="admin-nav-link active" data-tab="tabOverview">📊 Overview</a></li>
          <li><a href="#" class="admin-nav-link" data-tab="tabBuildings">🏢 Buildings</a></li>
          <li><a href="#" class="admin-nav-link" data-tab="tabReviews">⭐ Reviews</a></li>
          <li><a href="#" class="admin-nav-link" data-tab="tabComments">💬 Comments</a></li>
          <li><a href="#" class="admin-nav-link" data-tab="tabUsers">👤 Users</a></li>
          <li><a href="#" class="admin-nav-link" data-tab="tabViolations">⚠️ Violations</a></li>
          <li><a href="#" class="admin-nav-link" data-tab="tabIssues">🚨 Issues</a></li>
        </ul>
      </aside>

      <!-- MAIN -->
      <main class="admin-main">

        <!-- OVERVIEW -->
        <section class="admin-section active" id="tabOverview">
          <h2 class="admin-section-title">Overview</h2>
          <div class="admin-stats-grid" id="overviewStats"></div>
        </section>

        <!-- BUILDINGS -->
        <section class="admin-section" id="tabBuildings">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
            <h2 class="admin-section-title" style="margin:0;">Buildings</h2>
            <button class="btn btn-primary" id="addBuildingBtn">+ Add Building</button>
          </div>
          <div id="buildingsTableWrap"></div>
        </section>

        <!-- REVIEWS -->
        <section class="admin-section" id="tabReviews">
          <h2 class="admin-section-title">All Reviews</h2>
          <p style="color:var(--text-muted);font-size:0.87rem;margin-bottom:20px;">Delete any review to remove it from the building page.</p>
          <div id="reviewsTableWrap"></div>
        </section>

        <!-- COMMENTS -->
        <section class="admin-section" id="tabComments">
          <h2 class="admin-section-title">All Comments</h2>
          <p style="color:var(--text-muted);font-size:0.87rem;margin-bottom:20px;">Delete any comment to remove it from the building page.</p>
          <div id="commentsTableWrap"></div>
        </section>

        <!-- USERS -->
        <section class="admin-section" id="tabUsers">
          <h2 class="admin-section-title">Registered Users</h2>
          <div id="usersTableWrap"></div>
        </section>

        <!-- VIOLATIONS -->
        <section class="admin-section" id="tabViolations">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
            <h2 class="admin-section-title" style="margin:0;">Violations</h2>
            <button class="btn btn-primary" id="addViolationBtn">+ Add Violation</button>
          </div>
          <p style="color:var(--text-muted);font-size:0.87rem;margin-bottom:20px;">Manage building violations. Toggle status between Open and Closed or delete entries.</p>
          <div id="violationsTableWrap"></div>
        </section>

        <!-- ISSUES -->
        <section class="admin-section" id="tabIssues">
          <h2 class="admin-section-title">User-Reported Issues</h2>
          <p style="color:var(--text-muted);font-size:0.87rem;margin-bottom:20px;">Issues submitted by tenants. Delete resolved or spam reports.</p>
          <div id="issuesTableWrap"></div>
        </section>

      </main>
    </div>

    <!-- ADD BUILDING MODAL -->
    <div class="modal-overlay" id="addBuildingModal">
      <div class="modal" style="max-width:600px;max-height:90vh;overflow-y:auto;">
        <button class="modal-close" id="closeAddBuilding">✕</button>
        <h2 class="modal-title">Add Building</h2>

        <div style="display:flex;flex-direction:column;gap:14px;margin-top:8px;">
          <div class="form-row">
            <div class="form-group"><label>Building Name</label><input type="text" id="ab_name" /></div>
            <div class="form-group"><label>Badge</label>
              <select id="ab_badge">
                <option value="">None</option>
                <option>New</option><option>Hot</option><option>Deal</option>
              </select>
            </div>
          </div>
          <div class="form-group"><label>Address</label><input type="text" id="ab_address" /></div>
          <div class="form-row">
            <div class="form-group"><label>City</label><input type="text" id="ab_city" /></div>
            <div class="form-group"><label>Zip</label><input type="text" id="ab_zip" /></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label>Price / mo ($)</label><input type="number" id="ab_price" /></div>
            <div class="form-group"><label>Units</label><input type="number" id="ab_units" /></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label>Beds</label><input type="number" id="ab_beds" /></div>
            <div class="form-group"><label>Baths</label><input type="number" id="ab_baths" /></div>
            <div class="form-group"><label>Sqft</label><input type="number" id="ab_sqft" /></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label>Borough / County</label><input type="text" id="ab_borough" /></div>
            <div class="form-group"><label>Block</label><input type="text" id="ab_block" /></div>
            <div class="form-group"><label>Lot</label><input type="text" id="ab_lot" /></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label>Latitude</label><input type="number" id="ab_lat" step="0.0001" /></div>
            <div class="form-group"><label>Longitude</label><input type="number" id="ab_lng" step="0.0001" /></div>
          </div>
          <div class="form-group">
            <label>Rent Stabilized</label>
            <select id="ab_rentStab">
              <option value="false">No</option>
              <option value="true">Yes</option>
            </select>
          </div>
          <div class="form-group">
            <label>Amenities</label>
            <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:6px;">
              <label class="amenity-checkbox"><input type="checkbox" class="ab_amenity" value="Gym" /> Gym</label>
              <label class="amenity-checkbox"><input type="checkbox" class="ab_amenity" value="Parking" /> Parking</label>
              <label class="amenity-checkbox"><input type="checkbox" class="ab_amenity" value="Laundry" /> Laundry</label>
              <label class="amenity-checkbox"><input type="checkbox" class="ab_amenity" value="Doorman" /> Doorman</label>
              <label class="amenity-checkbox"><input type="checkbox" class="ab_amenity" value="Rooftop" /> Rooftop</label>
              <label class="amenity-checkbox"><input type="checkbox" class="ab_amenity" value="Pet Friendly" /> Pet Friendly</label>
            </div>
          </div>
          <div id="addBuildingError" style="color:var(--danger);font-size:0.85rem;display:none;"></div>
          <button class="btn btn-primary full-width" id="submitAddBuilding">Add Building</button>
        </div>
      </div>
    </div>

    <!-- ADD VIOLATION MODAL -->
    <div class="modal-overlay" id="addViolationModal">
      <div class="modal" style="max-width:520px;">
        <button class="modal-close" id="closeAddViolation">✕</button>
        <h2 class="modal-title">Add Violation</h2>
        <div style="display:flex;flex-direction:column;gap:14px;margin-top:8px;">
          <div class="form-group">
            <label>Building</label>
            <select id="av_buildingId"></select>
          </div>
          <div class="form-group">
            <label>Code</label>
            <input type="text" id="av_code" />
          </div>
          <div class="form-group">
            <label>Description</label>
            <textarea id="av_description" rows="3" style="resize:vertical;"></textarea>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>Severity</label>
              <select id="av_severity">
                <option>Minor</option>
                <option>Serious</option>
                <option>Hazardous</option>
              </select>
            </div>
            <div class="form-group">
              <label>Status</label>
              <select id="av_status">
                <option>Open</option>
                <option>Closed</option>
              </select>
            </div>
            <div class="form-group">
              <label>Date</label>
              <input type="date" id="av_date" />
            </div>
          </div>
          <div id="addViolationError" style="color:var(--danger);font-size:0.85rem;display:none;"></div>
          <button class="btn btn-primary full-width" id="submitAddViolation">Add Violation</button>
        </div>
      </div>
    </div>

    <!-- TOAST -->
    <div class="toast" id="toast"></div>

    <script>
      window.ADMIN_BUILDINGS   = {{{buildingsJson}}};
      window.ADMIN_USERS       = {{{usersJson}}};
      window.ADMIN_REVIEWS     = {{{reviewsJson}}};
      window.ADMIN_COMMENTS    = {{{commentsJson}}};
      window.ADMIN_ISSUES      = {{{issuesJson}}};
      window.ADMIN_VIOLATIONS  = {{{violationsJson}}};
    </script>
    <script src="/js/auth.js"></script>
    <script src="/js/admin-interactive.js"></script>
