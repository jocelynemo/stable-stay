    <!-- HERO -->
    <section class="hero">
<div class="hero-content">
        <h1 class="hero-title">
          Find Your <em>Perfect</em><br />Place to Rent
        </h1>
        <p class="hero-subtitle">
          Browse thousands of apartments, lofts, and homes across New York.
          Filter by city, price, and amenities to find exactly what you need.
        </p>

        <div class="hero-search">
          <input
            type="search"
            id="heroSearch"
            placeholder="Search by city, zip, or building name..."
            autocomplete="off"
          />
          <button id="heroSearchBtn">Search</button>
        </div>

        <div class="hero-stats">
          <div class="hero-stat">
            <span class="hero-stat-number">1,200+</span>
            <span class="hero-stat-label">Active Listings</span>
          </div>
          <div class="hero-stat">
            <span class="hero-stat-number">50+</span>
            <span class="hero-stat-label">NY Cities</span>
          </div>
          <div class="hero-stat">
            <span class="hero-stat-number">4.9★</span>
            <span class="hero-stat-label">Renter Rated</span>
          </div>
        </div>
      </div>
    </section>


    <!-- HOW IT WORKS -->
    <section class="section how-it-works">
      <div class="section-header">
        <span class="section-tag">How It Works</span>
        <h2 class="section-title">Renting Made Simple</h2>
      </div>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-number">01</div>
          <div class="step-icon">🔍</div>
          <div class="step-title">Search & Filter</div>
          <p class="step-desc">Search by city, zip, price range, bedrooms, and amenities to narrow down your options fast.</p>
        </div>
        <div class="step-card">
          <div class="step-number">02</div>
          <div class="step-icon">♥</div>
          <div class="step-title">Save Favorites</div>
          <p class="step-desc">Heart the listings you love and find them all in one place on your profile page.</p>
        </div>
        <div class="step-card">
          <div class="step-number">03</div>
          <div class="step-icon">📞</div>
          <div class="step-title">Contact &amp; Tour</div>
          <p class="step-desc">Reach out directly to property managers to schedule a viewing or ask questions.</p>
        </div>
        <div class="step-card">
          <div class="step-number">04</div>
          <div class="step-icon">🏠</div>
          <div class="step-title">Move In</div>
          <p class="step-desc">Sign your lease, pick up your keys, and settle into your new home.</p>
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="section" id="about">
      <div class="about-grid">
        <div class="about-body">
          <span class="section-tag">About StableStay</span>
          <h2 class="section-title">We're on Your Side</h2>
          <p>StableStay was built by renters for renters. We got tired of cluttered, ad-heavy platforms that bury the listings you actually want — so we built something cleaner and faster.</p>
          <p>Our platform focuses on the New York market, giving you hyper-local data, accurate pricing, and direct access to landlords and property managers without the runaround.</p>
          <ul class="about-features">
            <li>No hidden fees or pay-to-see listings</li>
            <li>Real-time listing updates daily</li>
            <li>Direct landlord contact info included</li>
            <li>Verified property reviews from real renters</li>
            <li>Mobile-friendly from day one</li>
          </ul>
          <a href="/buildings" class="btn btn-primary">Start Browsing</a>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="section contact" id="contact">
      <div class="section-header">
        <span class="section-tag">Support</span>
        <h2 class="section-title">Get In Touch</h2>
        <p class="section-sub">Have a question or need help finding a place? We're here for you.</p>
      </div>

      <div class="contact-grid">
        <div class="contact-info">
          <div class="contact-item">
            <span class="contact-icon">📧</span>
            <div>
              <div class="contact-item-title">Email</div>
              <div class="contact-item-detail">support@StableStay.com</div>
            </div>
          </div>
          <div class="contact-item">
            <span class="contact-icon">📞</span>
            <div>
              <div class="contact-item-title">Phone</div>
              <div class="contact-item-detail">201-328-2784</div>
            </div>
          </div>
        </div>

        <form class="contact-form" id="contactForm" autocomplete="off">
          <div class="form-row">
            <div class="form-group">
              <label>First Name</label>
              <input type="text" id="contactFirst" autocomplete="off" />
            </div>
            <div class="form-group">
              <label>Last Name</label>
              <input type="text" id="contactLast" autocomplete="off" />
            </div>
          </div>
          <div class="form-group">
            <label>Email</label>
            <input type="text" id="contactEmail" autocomplete="off" />
          </div>
          <div class="form-group">
            <label>Subject</label>
            <select id="contactSubject">
              <option value="">Select a topic</option>
              <option>Finding a rental</option>
              <option>Listing my property</option>
              <option>Account help</option>
              <option>Other</option>
            </select>
          </div>
          <div class="form-group">
            <label>Message</label>
            <textarea id="contactMessage"></textarea>
          </div>
          <div id="contactMsg" style="display:none;padding:10px 14px;border-radius:6px;margin-bottom:10px;font-size:0.88rem;"></div>
          <button type="submit" class="btn btn-primary full-width" id="contactSubmit">Send Message</button>
        </form>
      </div>
    </section>

