<nav class="navbar">
  <a class="nav-logo" href="/">Stable<span>Stay</span></a>
  <ul class="nav-links">
    <li><a href="/">Home</a></li>
    <li><a href="/buildings">Browse Rentals</a></li>
    <li><a href="/#about">About</a></li>
    <li><a href="/#contact">Contact</a></li>
    {{#if sessionUser}}<li><a href="/profile">My Profile</a></li>{{/if}}
  </ul>
  <div class="nav-actions">
    {{#if sessionUser}}
      <span style="font-size:0.88rem;color:var(--text-muted);font-weight:500;padding:0 4px;">Hi, {{sessionUser.firstName}}</span>
      {{#if sessionUser.isAdmin}}<a href="/admin" class="btn btn-ghost">Admin</a>{{/if}}
      <a href="/profile" class="btn btn-ghost">My Profile</a>
      <a href="/logout" class="btn btn-primary">Sign Out</a>
    {{else}}
      <button type="button" class="btn btn-ghost" id="signInBtn">Sign In</button>
      <button type="button" class="btn btn-primary" id="registerBtn">Get Started</button>
    {{/if}}
  </div>
</nav>

<div class="building-hero" id="buildingHero">
  <div class="building-hero-top">
    <div>
      <div class="building-badges">
        {{#if building.rentStabilized}}
          <span class="detail-badge badge-green">Rent Stabilized</span>
        {{else}}
          <span class="detail-badge badge-muted">Not Stabilized</span>
        {{/if}}
        {{#if building.badge}}<span class="detail-badge badge-white">{{building.badge}}</span>{{/if}}
      </div>
      <h1 class="building-hero-name">{{building.name}}</h1>
      <div class="building-hero-address">📍 {{building.address}}, {{building.city}}, {{building.zip}}</div>
      <div class="building-hero-price">
        ${{building.price}}<span>/mo</span>&nbsp;&nbsp;·&nbsp;&nbsp;
        {{building.beds}} bd&nbsp;&nbsp;·&nbsp;&nbsp;{{building.baths}} ba&nbsp;&nbsp;·&nbsp;&nbsp;{{building.sqft}} sqft
      </div>
    </div>
    <div class="building-hero-actions">
      <button type="button" class="btn {{#if favorited}}btn-primary{{else}}btn-ghost{{/if}}" id="favBtn" data-id="{{building._id}}">{{#if favorited}}♥ Saved{{else}}♡ Save{{/if}}</button>
      <a href="/buildings" class="btn btn-ghost">← Back</a>
    </div>
  </div>
</div>

<div class="building-detail-layout">
  <div class="building-detail-main">

    <div class="detail-card">
      <div class="detail-section-title">Building Details</div>
      <div id="buildingInfoCard">
        <div class="info-row"><span class="info-label">Address</span><span>{{building.address}}, {{building.city}}, {{building.zip}}</span></div>
        <div class="info-row"><span class="info-label">Borough / County</span><span>{{building.borough}}</span></div>
        <div class="info-row"><span class="info-label">Block / Lot</span><span>{{building.block}} / {{building.lot}}</span></div>
        <div class="info-row"><span class="info-label">Total Units</span><span>{{building.units}}</span></div>
        <div class="info-row"><span class="info-label">Rent status</span><span>{{#if building.rentStabilized}}✓ Rent-stabilized{{else}}✗ Not on stabilization list{{/if}}</span></div>
        <div class="info-row"><span class="info-label">Recorded violations</span><span>{{building.violationCount}} (see table below for detail &amp; severity)</span></div>
        {{#if building.amenities.length}}
        <div class="info-row">
          <span class="info-label">Amenities</span>
          <span class="amenity-tags">
            {{#each building.amenities}}<span class="amenity-tag">{{this}}</span>{{/each}}
          </span>
        </div>
        {{/if}}
      </div>
    </div>

    <div class="detail-card">
      <div class="detail-section-title">Violation History</div>
      <p style="font-size:0.85rem;color:var(--text-muted);margin-bottom:14px;">
        NYC Housing Maintenance Code violations. Severity follows NYC class (A/B/C): Minor, Serious, or Hazardous — aligned with our database design for plain-English labels.
      </p>
      <div id="violationsSection">
        {{#if building.violations.length}}
        <div style="overflow-x:auto">
          <table class="violation-table">
            <thead>
              <tr>
                <th data-col="0">Date</th>
                <th data-col="1">Code</th>
                <th data-col="2">Description</th>
                <th data-col="3">Severity</th>
                <th data-col="4">Status</th>
              </tr>
            </thead>
            <tbody>
              {{#each building.violations}}
              <tr>
                <td>{{date}}</td>
                <td style="white-space:nowrap">{{code}}</td>
                <td>{{description}}</td>
                <td><span class="severity-badge">{{severity}}</span></td>
                <td><span class="status-badge">{{status}}</span></td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        {{else}}
        <p class="empty-state">✓ No violations on record — a great sign!</p>
        {{/if}}
      </div>
    </div>

    <div class="detail-card">
      <div class="detail-section-title">Reviews</div>
      <p style="font-size:0.85rem;color:var(--text-muted);margin-bottom:14px;">
        One review per signed-in user per building (star rating + written feedback). Sorted newest first. Average rating is reflected on listings and here.
      </p>
      <div id="reviewsSection">
        <div class="avg-rating-row">
          <span class="avg-rating-big">{{avgDisplay}}</span>
          <div>
            <div class="avg-stars" style="letter-spacing:2px;color:#f59e0b;">{{{avgStarsStr}}}</div>
            <div class="avg-count">{{reviewCount}} review{{#if reviewsPlural}}s{{/if}}</div>
          </div>
        </div>

        {{#unless sessionUser}}
        <div class="review-form-wrap" style="text-align:center;padding:24px 18px;">
          <p style="color:var(--text-muted);margin-bottom:14px;">Sign in to leave a review.</p>
          <button type="button" class="btn btn-primary" id="reviewSignInBtn">Sign In</button>
        </div>
        {{else}}
          {{#if userReview}}
          <div class="review-form-wrap" id="myReviewWrap">
            <div class="detail-section-subtitle">Your review</div>
            <span id="myReviewFullText" style="display:none">{{userReview.text}}</span>
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
              <span style="font-size:1.1rem;letter-spacing:2px;color:#f59e0b;">{{{userReview.stars}}}</span>
              <span style="font-size:0.8rem;color:var(--text-muted);">{{userReview.dateFormatted}}</span>
            </div>
            <p style="font-size:0.9rem;color:var(--text-muted);margin-bottom:14px;">{{userReview.text}}</p>
            <div style="display:flex;gap:10px;flex-wrap:wrap;">
              <button type="button" class="btn btn-ghost" id="editReviewBtn" data-id="{{userReview._id}}" data-rating="{{userReview.rating}}">Edit</button>
              <button type="button" class="btn btn-ghost" id="deleteReviewBtn" data-id="{{userReview._id}}" style="color:var(--danger);border-color:rgba(248,113,113,0.3);">Delete</button>
            </div>
          </div>
          {{else}}
          <div class="review-form-wrap">
            <div class="detail-section-subtitle">Leave a review</div>
            <div class="star-input" id="starRow">
              <button type="button" class="star-btn star-pick" data-val="1" aria-label="1 star">★</button>
              <button type="button" class="star-btn star-pick" data-val="2" aria-label="2 stars">★</button>
              <button type="button" class="star-btn star-pick" data-val="3" aria-label="3 stars">★</button>
              <button type="button" class="star-btn star-pick" data-val="4" aria-label="4 stars">★</button>
              <button type="button" class="star-btn star-pick" data-val="5" aria-label="5 stars">★</button>
            </div>
            <input type="hidden" id="reviewRating" value="" />
            <textarea id="reviewText" placeholder="Share your experience (at least 5 characters)…" rows="3"></textarea>
            <div id="reviewError" style="color:var(--danger);font-size:0.85rem;display:none;margin-bottom:8px;"></div>
            <button type="button" class="btn btn-primary" id="submitReview" data-building="{{building._id}}">Submit Review</button>
          </div>
          {{/if}}
        {{/unless}}

        <div class="reviews-list">
          {{#each reviewsListOthers}}
          <div class="review-card">
            <div class="review-header">
              <span class="review-user">{{displayName}}</span>
              <span class="review-stars" style="letter-spacing:1px;color:#f59e0b;">{{{stars}}}</span>
              <span class="review-date">{{dateFormatted}}</span>
            </div>
            <p class="review-text">{{text}}</p>
          </div>
          {{/each}}
          {{#unless reviewsListOthers.length}}
          {{#unless userReview}}
          <p class="empty-state">No reviews yet. Be the first!</p>
          {{/unless}}
          {{/unless}}
        </div>
      </div>
    </div>

    <div class="detail-card">
      <div class="detail-section-title">Reported Issues</div>
      <p style="font-size:0.85rem;color:var(--text-muted);margin-bottom:18px;">
        User-reported problems (pests, noise, maintenance neglect, etc.) — separate from official NYC violations.
      </p>
      <div id="issuesSection">
        {{#if sessionUser}}
        <div class="issue-form-wrap">
          <div class="detail-section-subtitle">Report an issue</div>
          <select id="issueType" class="filter-input">
            <option value="">Select issue type</option>
            <option>Pests</option>
            <option>Noise</option>
            <option>Maintenance Neglect</option>
            <option>Heat/Hot Water</option>
            <option>Safety Concern</option>
            <option>Other</option>
          </select>
          <textarea id="issueDescription" placeholder="Describe what happened (at least 10 characters)…" rows="3"></textarea>
          <div id="issueError" style="color:var(--danger);font-size:0.85rem;display:none;margin-bottom:8px;"></div>
          <button type="button" class="btn btn-primary" id="submitIssue" data-building="{{building._id}}">Submit Report</button>
        </div>
        {{else}}
        <p style="color:var(--text-muted);font-size:0.9rem;margin-bottom:16px;">Sign in to report an issue for this building.</p>
        {{/if}}
        <div class="issues-list">
          {{#each issues}}
          <div class="issue-card">
            <div class="issue-header">
              <span class="issue-type">{{type}}</span>
              <span class="issue-user">{{displayName}} · {{dateFormatted}}</span>
            </div>
            <p class="issue-desc">{{description}}</p>
            {{#if isOwner}}
            <button type="button" class="btn btn-ghost issue-delete-btn" data-id="{{_id}}" style="margin-top:8px;color:var(--danger);">Delete</button>
            {{/if}}
          </div>
          {{/each}}
          {{#unless issues.length}}
          <p class="empty-state">No user reports yet.</p>
          {{/unless}}
        </div>
      </div>
    </div>

    <div class="detail-card">
      <div class="detail-section-title">Comments &amp; Q&amp;A</div>
      <p style="font-size:0.85rem;color:var(--text-muted);margin-bottom:14px;">
        Multiple comments per user are allowed (unlike the single review). Use this thread for quick questions and neighborhood tips.
      </p>
      <div id="commentsSection">
        {{#if sessionUser}}
        <div class="comment-form-wrap">
          <textarea id="commentText" placeholder="Ask a question or add a comment…" rows="2"></textarea>
          <div id="commentError" style="color:var(--danger);font-size:0.85rem;display:none;margin-bottom:8px;"></div>
          <button type="button" class="btn btn-primary" id="submitComment" data-building="{{building._id}}">Post Comment</button>
        </div>
        {{else}}
        <p style="color:var(--text-muted);font-size:0.9rem;margin-bottom:16px;">Sign in to post a comment.</p>
        {{/if}}
        <div class="comments-list">
          {{#each comments}}
          <div class="comment-card">
            <div class="comment-header">
              <span class="comment-user">{{displayName}}</span>
              <span class="comment-date">{{dateFormatted}}</span>
            </div>
            <p class="comment-text">{{text}}</p>
            {{#if isOwner}}
            <button type="button" class="btn btn-ghost comment-delete-btn" data-id="{{_id}}" style="margin-top:8px;color:var(--danger);">Delete</button>
            {{/if}}
          </div>
          {{/each}}
          {{#unless comments.length}}
          <p class="empty-state">No comments yet. Start the conversation!</p>
          {{/unless}}
        </div>
      </div>
    </div>

  </div>

  <div class="building-detail-sidebar">
    <div class="detail-card">
      <div class="detail-section-title">Trust Score</div>
      <div id="trustScoreCard">
        <div class="trust-score-big trust-score-dynamic" data-score="{{building.trustScore}}">{{building.trustScore}}</div>
        <div class="trust-score-label trust-score-dynamic-label" data-score="{{building.trustScore}}">Trust Score</div>
        <p style="font-size:0.82rem;color:var(--text-muted);margin-top:12px;line-height:1.45;">
          Composite score (0–100) from recorded violations, rent-stabilization status, and average tenant review rating — per project spec and database design.
        </p>
      </div>
    </div>
    <div class="detail-card">
      <div class="detail-section-title">Quick Actions</div>
      <div style="display:flex;flex-direction:column;gap:10px;">
        <a href="/buildings" class="btn btn-ghost full-width">← All Listings</a>
        <a href="/buildings" class="btn btn-ghost full-width">Saved ♥ filter</a>
        <a href="/profile" class="btn btn-ghost full-width">View Profile</a>
      </div>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script src="/js/auth.js"></script>
<script src="/js/building-interactive.js"></script>
